{
  "name": "speedhacks-refund-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Hackathon refund assistant: upload evidence, review facts, authorize one support call, see an evidence-backed outcome.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:live": "node --env-file=\"$HOME/.config/speedhacks/dial.env\" node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "start:live": "node --env-file=\"$HOME/.config/speedhacks/dial.env\" node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keewano:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local src/integrations/keewano/seed.mts",
    "keewano:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local src/integrations/keewano/sql.mts",
    "keewano:demo-cases": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local src/integrations/keewano/demo-cases.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}

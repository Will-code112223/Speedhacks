# Copy to .env and keep that file private. Node --env-file=.env loads it.
WORLDS_MODEL_PROVIDER=anthropic
# Choose a model available to your Anthropic account. This is an explicit example.
WORLDS_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# Every model request may cost money; set an account spending limit too.
WORLDS_AGENT_MAX_STEPS=12
WORLDS_AGENT_MAX_TOKENS=1024
WORLDS_AGENT_TIMEOUT_MS=120000
# Optional Anthropic-compatible loopback proxy (numeric loopback origin only):
# WORLDS_MODEL_BASE_URL=http://127.0.0.1:8000
# WORLDS_LOCAL_MODEL_KEY=
# Twin URL/key/task come from the runner. Never put real connector keys here.

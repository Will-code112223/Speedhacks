# Copy to .env.local (git-ignored). Never commit real keys.

# "simulated" works with no credentials and is labeled as simulated in data and UI.
# "live" requires every LIVE_* / provider variable below; a missing one fails visibly (503), never falls back.
REFUND_MODE=simulated

# Local persistence (hackathon setup; not suitable for ephemeral serverless disks).
DATA_DIR=./data

# LLM extraction (live mode only). No default model id is assumed; set one you have verified.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# Dial voice provider (live mode only; names per docs/handoffs/dial.txt). Never NEXT_PUBLIC_.
DIAL_API_KEY=
DIAL_FROM_NUMBER=
DIAL_WEBHOOK_SECRET=
# Optional, 60..3600 seconds; default 300. Leave commented out or set a value: a blank value is rejected.
# DIAL_MAX_CALL_DURATION_SECONDS=300

# Keewano (optional sponsor integration; the refund flow works without it). Never NEXT_PUBLIC_.
# API key (Settings → Project → API Keys): every case is mirrored into Keewano as it changes.
KEEWANO_API_KEY=
# Personal access token (Settings → Personal → Security, "kwpat-…"): the pre-authorization
# duplicate-charge check queries the customer's charge history over Keewano MCP.
KEEWANO_ACCESS_TOKEN=
# Without a token in simulated mode the check reads the labeled local fixture
# (src/integrations/keewano/seed/transactions.json). Set "off" to disable the check entirely.
# KEEWANO_FIXTURE_HISTORY=off
# Project UUID for queries; normally read from the API key (or list_projects when there is one project).
# KEEWANO_PROJECT_ID=
# Override the discovered MCP tool/argument names once known (see npm run keewano:sql -- --tools).
# KEEWANO_SQL_TOOL=
# KEEWANO_SQL_ARG=
# Charges of the same merchant and amount this close together count as a duplicate (default 1440 = 24h).
# KEEWANO_HISTORY_WINDOW_MINUTES=1440

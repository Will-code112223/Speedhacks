# Copy to .env.local (git-ignored). Never commit real keys.

# "simulated" works with no credentials and is labeled as simulated in data and UI.
# "live" requires every LIVE_* / provider variable below; a missing one fails visibly (503), never falls back.
REFUND_MODE=simulated

# Local persistence (hackathon setup; not suitable for ephemeral serverless disks).
DATA_DIR=./data

# LLM extraction (live mode only). No default model id is assumed; set one you have verified.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# Dial voice provider (live mode only; names per docs/handoffs/dial.txt). Never NEXT_PUBLIC_.
DIAL_API_KEY=
DIAL_FROM_NUMBER=
# The DIAL_FROM_NUMBER line must have SMS enabled in Dial for text summaries (POST /api/cases/:id/summary).
DIAL_WEBHOOK_SECRET=
# Optional, 60..3600 seconds; default 300. Leave commented out or set a value: a blank value is rejected.
# DIAL_MAX_CALL_DURATION_SECONDS=300

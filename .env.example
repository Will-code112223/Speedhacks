# Copy to .env.local (git-ignored). Never commit real keys.

# Live is the default, including when this variable is omitted or blank.
# Simulated adapters are allowed only with NODE_ENV=test, never a runtime fallback.
REFUND_MODE=live

# Local persistence (hackathon setup; not suitable for ephemeral serverless disks).
DATA_DIR=./data

# LLM extraction (live mode only). No default model id is assumed; set one you have verified.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
# Optional OpenAI-compatible Responses API endpoint; leave unset for the official API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Dial voice provider (live mode only; names per docs/handoffs/dial.txt). Never NEXT_PUBLIC_.
DIAL_API_KEY=
DIAL_FROM_NUMBER=
# Optional for calls reconciled by polling; required for authenticated webhooks.
# The DIAL_FROM_NUMBER line must have SMS enabled in Dial for text summaries (POST /api/cases/:id/summary).
DIAL_WEBHOOK_SECRET=
# Optional integer, 60..3600 seconds; absent/blank defaults to 300 in server config.
# DIAL_MAX_CALL_DURATION_SECONDS=300

# Browser execution is real and requires explicit opt-in, an installed browser,
# and the LLM settings above. Installation: npx playwright install chromium
BROWSER_ENABLED=false
# Local visible browser by default. A headless server must set this explicitly.
BROWSER_HEADLESS=false
# Optional absolute executable path instead of Playwright's installed Chromium.
# BROWSER_EXECUTABLE_PATH=

# Optional live-only Keewano event mirror. Select a fresh project with no seeded/demo
# history before setting the confirmation flag. No MCP/PAT or customer-history query.
KEEWANO_API_KEY=
KEEWANO_LIVE_PROJECT_CONFIRMED=false
